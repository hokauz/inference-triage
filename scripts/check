#!/bin/sh

set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)

fail() {
  printf 'FAIL: %s\n' "$1" >&2
  return 1
}

pass() {
  printf 'PASS: %s\n' "$1"
}

require_dir() {
  if [ ! -d "$ROOT/$1" ]; then
    fail "missing directory: $1"
    return 1
  fi
}

require_file() {
  if [ ! -f "$ROOT/$1" ]; then
    fail "missing file: $1"
    return 1
  fi
}

check_structure() {
  dirs='platform/contracts platform/database runtimes/typescript/src/core runtimes/typescript/src/runner/composer runtimes/typescript/src/adapters runtimes/typescript/src/commands runtimes/typescript/test runtimes/python/src/core runtimes/python/src/runner/composer runtimes/python/src/adapters runtimes/python/src/commands runtimes/python/test assets/ingestion/schemas assets/ingestion/mappings assets/ingestion/normalizers assets/policies/finguard assets/prompts/finguard assets/taxonomies/finguard assets/packs/finguard experiments/compositions experiments/benchmarks datasets/source/finguard datasets/curated/finguard datasets/gold/finguard datasets/fixtures/finguard interfaces/api interfaces/web interfaces/cli interfaces/exporters compose/benchmarks checks/structure checks/contracts checks/e2e/v0/fixtures checks/e2e/v0/expected checks/resources'

  for dir in $dirs; do
    require_dir "$dir" || return 1
  done

  require_file README.md || return 1
  require_file runtimes/typescript/package.json || return 1
  require_file runtimes/typescript/bun.lock || return 1
  require_file concept/initial.md || return 1
  require_file checks/README.md || return 1
  require_file compose/README.md || return 1
  require_file runtimes/typescript/tsconfig.json || return 1
  require_file platform/database/migrations/0001_v0.sql || return 1
  require_file compose/benchmarks/v0-mock/Dockerfile || return 1
  require_file compose/benchmarks/v0-mock/compose.yaml || return 1
  require_file compose/benchmarks/v0-finguard/compose.yaml || return 1
  require_file compose/benchmarks/v0-laya/compose.yaml || return 1
  require_file models/laya/README.md || return 1
  require_file models/laya/manifest.json || return 1
  pass 'repository structure'
}

check_contracts() {
  require_file checks/e2e/v0/README.md || return 1
  require_file checks/contracts/v0.md || return 1
  require_file checks/e2e/v0/fixtures/complaints.csv || return 1
  require_file checks/e2e/v0/fixtures/security.csv || return 1
  require_file checks/e2e/v0/expected/properties.txt || return 1
  require_file checks/e2e/v0/expected/security-properties.txt || return 1
  require_file assets/packs/finguard/pack.yaml || return 1
  require_file assets/taxonomies/finguard/taxonomy-v1.yaml || return 1
  require_file assets/policies/finguard/POL-SAC-001-v2.0.md || return 1
  require_file platform/contracts/report-data-classes-v1.md || return 1

  input_count=$(($(grep -cve '^[[:space:]]*$' "$ROOT/checks/e2e/v0/fixtures/complaints.csv" || true) - 1))
  if [ "$input_count" -lt 1 ]; then
    fail 'V0 fixture must contain at least one non-empty input'
    return 1
  fi

  pass "V0 contracts, FinGuard assets and fixtures ($input_count inputs)"
}

check_e2e_v0() {
  output_dir=$(mktemp -d "${TMPDIR:-/tmp}/inference-triage-v0.XXXXXX")
  cleanup() {
    rm -rf "$output_dir"
  }
  trap cleanup EXIT HUP INT TERM

  if ! (cd "$ROOT/runtimes/typescript" && bun run build); then
    fail 'TypeScript build'
    return 1
  fi

  run_fixture() {
    fixture="$1"
    target="$output_dir/$2"
    mkdir -p "$target"
    if ! (cd "$ROOT" && node runtimes/typescript/dist/src/commands/v0.js run --input "$fixture" --output-dir "$target" --pack assets/packs/finguard/pack.yaml --mode mock); then
      fail "V0 runner command for $(basename "$fixture")"
      return 1
    fi
    for file in benchmark_run.json sample_executions.jsonl benchmark.sqlite ingestion_report.json; do
      if [ ! -f "$target/$file" ]; then
        fail "V0 runner did not create $file"
        return 1
      fi
    done
    for property in status dataset_hash config_hash; do
      if ! grep -q "\"$property\"" "$target/benchmark_run.json"; then
        fail "benchmark_run.json is missing property: $property"
        return 1
      fi
    done
    if ! grep -q '"status": "completed"' "$target/benchmark_run.json"; then
      fail "benchmark_run.json did not complete for $(basename "$fixture")"
      return 1
    fi
    expected_count=$(($(grep -cve '^[[:space:]]*$' "$fixture" || true) - 1))
    output_count=$(grep -cve '^[[:space:]]*$' "$target/sample_executions.jsonl" || true)
    if [ "$expected_count" -ne "$output_count" ]; then
      fail "sample count mismatch for $(basename "$fixture"): input=$expected_count output=$output_count"
      return 1
    fi
    if ! node --input-type=module -e "import { DatabaseSync } from 'node:sqlite'; const db = new DatabaseSync(process.argv[1]); const views = db.prepare(\"SELECT COUNT(*) AS count FROM sqlite_master WHERE type = 'view' AND name IN ('report_public_samples', 'report_run_metrics')\").get().count; const rows = db.prepare('SELECT COUNT(*) AS count FROM report_public_samples').get().count; db.close(); if (views !== 2 || rows !== Number(process.argv[2])) process.exit(1);" "$target/benchmark.sqlite" "$expected_count"; then
      fail "SQLite public views for $(basename "$fixture")"
      return 1
    fi
  }

  run_fixture "$ROOT/checks/e2e/v0/fixtures/complaints.csv" "complaints" || return 1
  run_fixture "$ROOT/checks/e2e/v0/fixtures/security.csv" "security" || return 1

  if grep -Eqi '123\.456\.789-00|12345-6|external\.invalid|ignore as instru' "$output_dir/security/benchmark_run.json" "$output_dir/security/sample_executions.jsonl"; then
    fail 'public output contains security fixture content'
    return 1
  fi

  pass 'V0 end-to-end output contract'
}

usage() {
  printf '%s\n' \
    'usage: scripts/check {structure|contracts|e2e:v0|v0|all}'
}

command=${1:-all}
case "$command" in
  structure)
    check_structure
    ;;
  contracts)
    check_contracts
    ;;
  e2e:v0)
    check_e2e_v0
    ;;
  v0)
    check_structure
    check_contracts
    check_e2e_v0
    ;;
  all)
    check_structure
    check_contracts
    check_e2e_v0
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
