/var/*
!/var/.gitkeep

/artifacts/*
!/artifacts/.gitkeep
# Preserve public benchmark metadata/exports for the constrained V0 profile.
!/artifacts/v0-mock/
!/artifacts/v0-mock/*/
!/artifacts/v0-mock/*/benchmark_run.json
!/artifacts/v0-mock/*/sample_executions.jsonl
!/artifacts/v0-mock/*/ingestion_report.json
/artifacts/v0-mock/*/benchmark.sqlite

# Preserve the same public exports for the full FinGuard benchmark.
!/artifacts/v0-finguard/
!/artifacts/v0-finguard/*/
!/artifacts/v0-finguard/*/benchmark_run.json
!/artifacts/v0-finguard/*/sample_executions.jsonl
!/artifacts/v0-finguard/*/ingestion_report.json
/artifacts/v0-finguard/*/benchmark.sqlite

# Preserve public exports for Laya smoke/full runs; keep SQLite restricted.
!/artifacts/v0-laya/
!/artifacts/v0-laya/*/
!/artifacts/v0-laya/*/benchmark_run.json
!/artifacts/v0-laya/*/sample_executions.jsonl
!/artifacts/v0-laya/*/ingestion_report.json
!/artifacts/v0-laya/*/benchmark_checkpoint.json
!/artifacts/v0-laya/*/benchmark_analysis.json
/artifacts/v0-laya/*/benchmark.sqlite
/artifacts/v0-laya-local/*/benchmark.sqlite
/artifacts/*/*/review_queue.jsonl

/datasets/source/*
!/datasets/source/.gitkeep
!/datasets/source/finguard/
datasets/source/finguard/*
!/datasets/source/finguard/README.md

# JavaScript/TypeScript dependencies (any depth)
**/node_modules/

# Python environments and caches (any depth)
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]

# Build and test artifacts (any depth)
**/dist/
**/build/
**/coverage/

# Temporary runtime session markers.
*.ses

# Laya ONNX weights are prepared locally and identified by the tracked manifest.
/models/laya/multilingual/*
!/models/laya/multilingual/.gitkeep
/models/laya/multilingual-onnx/*
